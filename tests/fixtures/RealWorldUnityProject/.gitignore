# Unity regenerates these when the fixture project is opened/built by tests.
# They must never be tracked — otherwise the fixture looks "modified" and
# M19_VerifyProjectNotModified fails after any test run.
Library/
Build/
Logs/
UserSettings/
Temp/
obj/
.vscode/
*.csproj
*.sln
*.slnx

# Unity re-creates ProjectSettings assets when opening the project;
# keep only the two checked-in settings files.
ProjectSettings/*
!ProjectSettings/ProjectVersion.txt
!ProjectSettings/EditorBuildSettings.asset

# Files injected by runtime harness tests (GenericRuntimeBridge /
# GenericPlayerBuild) and Unity-generated URP global settings.
# Normally removed by test cleanup; ignore as a safety net so an
# interrupted run can't dirty the fixture.
Assets/Editor/
Assets/Scripts/GenericRuntimeBridge.cs
Assets/Scripts/GenericRuntimeBridge.cs.meta
Assets/UniversalRenderPipelineGlobalSettings.asset
Assets/UniversalRenderPipelineGlobalSettings.asset.meta
